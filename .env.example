# --- Auth -------------------------------------------------------------
# Leave AZURE_CLIENT_ID empty to run in DEV mode (pick-a-name sign in, no Microsoft login).
AZURE_CLIENT_ID=
# Optional: lock the app to a single tenant (your org's Directory/tenant ID). Empty = any work account.
AZURE_TENANT_ID=
# Public URL the app is served from (used for the Teams SSO audience api://<host>/<clientId> and share links)
APP_BASE_URL=http://localhost:3200
# Random long string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# --- Permissions ------------------------------------------------------
# "everyone" = any signed-in org member can create polls, "admins" = only ADMIN_EMAILS
POLL_CREATORS=everyone
ADMIN_EMAILS=etan@flnt.io

# --- Teams app package (npm run package:teams) -------------------------
# Stable GUID for the Teams app; leave empty to derive one from AZURE_CLIENT_ID
TEAMS_APP_ID=
TEAMS_APP_VERSION=

# --- Storage ------------------------------------------------------------
# Postgres connection string (Neon pooled URL on Vercel). Empty = local in-process Postgres (PGlite) in data/pglite.
DATABASE_URL=
# Optional: PGlite data folder for local dev (":memory:" = throwaway)
TP_DB_PATH=data/pglite
